```groovy
node {

    stage('SCM Checkout') {
        git credentialsId: 'GIT_CREDENTIALS',
            url: 'https://github.com/rakeshbathula421-maker/spring-boot-mongo-docker.git',
            branch: 'master'
    }

    stage('Maven Clean Package') {
        def mavenHome = tool name: 'Maven-3.9.12', type: 'maven'
        def mavenCMD = "${mavenHome}/bin/mvn"
        sh "${mavenCMD} clean package -DskipTests"
    }

    stage('Build Docker Image') {
        sh 'docker build -t rakesh1908/spring-boot-mongo .'
    }

    stage('Push Docker Image') {
        withCredentials([
            usernamePassword(
                credentialsId: 'docker-hub-creds',
                usernameVariable: 'DOCKER_USERNAME',
                passwordVariable: 'DOCKER_PASSWORD'
            )
        ]) {
            sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin'
        }

        sh 'docker push rakesh1908/spring-boot-mongo'
    }

    stage('Deploy To Kubernetes Cluster') {
        kubernetesDeploy(
            configs: 'springBootMongo.yml',
            kubeconfigId: 'KUBERNETES_CONFIG',
            enableConfigSubstitution: true
        )
    }
}
